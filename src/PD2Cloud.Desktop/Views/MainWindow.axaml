<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PD2Cloud.Desktop.ViewModels"
        xmlns:core="using:PD2Cloud.Core"
        x:Class="PD2Cloud.Desktop.Views.MainWindow" x:DataType="vm:MainWindowViewModel"
        Title="PD2 Cloud" Width="760" Height="680" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24" RowDefinitions="Auto,*" RowSpacing="24">
        <TextBlock Text="PD2 Cloud" FontSize="22" FontWeight="SemiBold" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20">
                <StackPanel IsVisible="{Binding IsInitial}" Spacing="16" Margin="0,12,0,20">
                    <TextBlock Text="Find your saves" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Select the folder where Project Diablo 2 stores your single-player saves." TextWrapping="Wrap" FontSize="15" />
                    <Button Content="Select Folder" Click="SelectFolder_Click" IsEnabled="{Binding CanSelect}"
                            FontSize="16" Padding="24,14" HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock Text="{Binding SettingsNotice}" TextWrapping="Wrap" IsVisible="{Binding HasSettingsNotice}" />
                <TextBlock Text="{Binding PickerNotice}" TextWrapping="Wrap" IsVisible="{Binding HasPickerNotice}" />
                <StackPanel IsVisible="{Binding HasFolder}" Spacing="16">
                    <TextBlock Text="Your files" FontSize="26" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding SelectedPath}" TextWrapping="Wrap" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Refresh" Click="Refresh_Click" IsEnabled="{Binding CanRefresh}" />
                        <Button Content="Change Folder" Click="SelectFolder_Click" IsEnabled="{Binding CanSelect}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    <StackPanel IsVisible="{Binding HasInspection}" Spacing="6">
                        <TextBlock Text="{Binding CountSummary}" />
                        <TextBlock Text="{Binding LastInspection}" Opacity="0.7" />
                        <TextBlock Text="No files in this folder." IsVisible="{Binding ShowEmpty}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:FileEntry">
                                <SelectableTextBlock Text="{Binding RelativePath}" TextWrapping="Wrap" Margin="0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="Inspection Details" IsExpanded="False" HorizontalAlignment="Stretch" IsVisible="{Binding HasInspection}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Validation issues and excluded entries" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:ValidationIssue">
                                        <StackPanel Margin="0,4" Spacing="3">
                                            <SelectableTextBlock Text="{Binding RelativePath}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="File sizes (bytes) and SHA-256" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:FileEntry">
                                        <StackPanel Margin="0,6" Spacing="3">
                                            <SelectableTextBlock Text="{Binding RelativePath}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SizeBytes}" Opacity="0.7" />
                                            <SelectableTextBlock Text="{Binding Sha256}" TextWrapping="Wrap" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Collection fingerprint" FontWeight="SemiBold" />
                            <SelectableTextBlock Text="{Binding CollectionFingerprint}" TextWrapping="Wrap" FontSize="11" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel DataContext="{Binding GitHub}" x:DataType="vm:GitHubConnectionViewModel" Spacing="12">
                        <TextBlock Text="GitHub connection" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Account}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
                        <StackPanel IsVisible="{Binding HasCode}" Spacing="8">
                            <SelectableTextBlock Text="{Binding VerificationAddress}" TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding UserCode}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                        <WrapPanel>
                            <Button Content="Connect to GitHub" Click="Connect_Click" IsEnabled="{Binding CanConnect}" Margin="0,0,8,8" />
                            <Button Content="Cancel" Click="CancelGitHub_Click" IsVisible="{Binding IsBusy}" Margin="0,0,8,8" />
                            <Button Content="Reload Repositories" Click="ReloadRepositories_Click" IsEnabled="{Binding CanReload}" Margin="0,0,8,8" />
                            <Button Content="Disconnect" Click="Disconnect_Click" IsEnabled="{Binding CanManage}" Margin="0,0,8,8" />
                        </WrapPanel>
                        <ComboBox ItemsSource="{Binding Repositories}" SelectedItem="{Binding Candidate}" IsEnabled="{Binding CanManage}" PlaceholderText="Choose a private repository" HorizontalAlignment="Stretch" />
                        <Button Content="Use Repository" Click="ChooseRepository_Click" IsEnabled="{Binding CanSelect}" />
                        <TextBlock Text="{Binding Selection}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
