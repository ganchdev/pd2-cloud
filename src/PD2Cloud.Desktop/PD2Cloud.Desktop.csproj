<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      The GitHub App client ID is public metadata, not a secret. Release
      builds inject it so a downloaded artifact works without environment
      configuration. It stays empty for local builds, where the
      PD2CLOUD_GITHUB_CLIENT_ID environment variable takes precedence.
    -->
    <DefaultGitHubClientId Condition="'$(DefaultGitHubClientId)' == ''"></DefaultGitHubClientId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PD2Cloud.DefaultGitHubClientId</_Parameter1>
      <_Parameter2>$(DefaultGitHubClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PD2Cloud.Remote/PD2Cloud.Remote.csproj" />
    <ProjectReference Include="../PD2Cloud.GitHub/PD2Cloud.GitHub.csproj" />
    <ProjectReference Include="../PD2Cloud.Platform/PD2Cloud.Platform.csproj" />
    <ProjectReference Include="../PD2Cloud.Core/PD2Cloud.Core.csproj" />
    <ProjectReference Include="../PD2Cloud.Local/PD2Cloud.Local.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
</Project>
